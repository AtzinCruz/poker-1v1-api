{
  "name": "poker-1v1-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API autoritativa de Póker Five-Card Draw 1 vs. 1 (REST). WebSocket queda para una siguiente iteración.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/api/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/api/start.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src test e2e",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-seed",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "loadtest": "node scripts/loadtest.mjs",
    "reconcile": "node scripts/reconcileBalances.mjs",
    "test:audit": "vitest run -c test/audit/vitest.config.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
