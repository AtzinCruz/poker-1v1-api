# Copia este archivo a .env y ajusta si hace falta.

# Postgres levantado por docker-compose.yml (puerto 5433 en el host para no chocar
# con otros proyectos que ya usan el 5432 por defecto)
DATABASE_URL="postgresql://poker:poker@localhost:5433/poker?schema=public"

# Usada por los tests de integracion (test/helpers/db.ts)
TEST_DATABASE_URL="postgresql://poker:poker@localhost:5433/poker_test?schema=public"

# Secreto para firmar los JWT emitidos por el stub de autenticacion de desarrollo.
# En produccion esto lo emitiria el modulo de identidad real, no esta API.
# Con NODE_ENV=production el servidor se niega a arrancar si es este valor o mide menos de 32 caracteres.
JWT_SECRET="dev-secret-change-me"

# Puerto HTTP del servidor Fastify
PORT=3000

# Clave para entrar al panel de administracion (POST /v1/auth/admin-session, pantalla /admin.html).
# Si se deja vacia o sin definir, el panel de admin queda deshabilitado.
ADMIN_SECRET="cambia-esto-en-produccion"

# --- Producción: rendimiento (opcionales) ---
# Pool de Prisma: por defecto núcleos*2+1. Las transacciones interactivas retienen la conexión
# durante todas sus consultas, así que el pool se agota antes que la CPU de Postgres. Fíjalo según
# el máximo de conexiones de tu plan de Postgres, repartido entre réplicas:
#   DATABASE_URL="postgresql://…/poker?schema=public&connection_limit=20&pool_timeout=5"
# scrypt (login) corre en el threadpool de libuv (4 hilos por defecto). Igualarlo a las vCPU de la
# máquina sube el techo de login: en un M1 de 8 núcleos, de ~100 a ~130 logins/s.
# UV_THREADPOOL_SIZE=8
